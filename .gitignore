# ---------------------------------------------------------------------------
# Data, samples, caches and other regenerable / bulky artefacts
# ---------------------------------------------------------------------------
# Pythia parent samples and hadronisation libraries (GB scale, regenerated by the
# Magnus jobs listed in each run's logs/samples.md)
**/work/magnus/samples/
**/work/magnus/samples_*/
**/work/magnus/hadron_lib/
**/work/magnus/hadron_lib_*/
**/work/magnus/outputs/
**/work/magnus/**/*.tar.gz
**/work/magnus/**/*.zip
# compiled response-table caches (rebuilt automatically from the code + samples)
**/work/analysis/cache/
# per-mass scan JSONs (reproducible; the aggregated outputs/data/signal_scan.json is kept)
**/work/analysis/scan_2hdm/
**/work/analysis/scan_2hdm_*/
# run archives
runs/*.zip
# ---------------------------------------------------------------------------
# Third-party and raw reference material (fetched from upstream, not redistributed)
# ---------------------------------------------------------------------------
references/
deployment/sources/
# ---------------------------------------------------------------------------
# Python / build junk
# ---------------------------------------------------------------------------
**/__pycache__/
*.pyc
*.pyo
build/
*.obj
*.o
# ---------------------------------------------------------------------------
# Local scratch
# ---------------------------------------------------------------------------
temp/*
!temp/.gitkeep

# local deployment secrets (JWT signer key, internal endpoints) - never publish
configs/magnus_container.private.json
