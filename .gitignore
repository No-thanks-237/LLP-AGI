# ---------------------------------------------------------------------------
# Data, samples, caches and other regenerable / bulky artefacts
# ---------------------------------------------------------------------------
# Gzipped Pythia parent samples and hadronisation libraries ARE tracked (see the
# "Data" section of README.md), but their uncompressed duplicates, backups and the
# Magnus job staging directories are not.
**/work/magnus/samples/out/
**/work/magnus/samples/*.txt
**/work/magnus/samples/*_backup*
**/work/magnus/samples/summary_partial.jsonl
# the older runs keep byte-identical copies of the same samples: keep one copy only
runs/20261016_144605_UTC_bc5_lhcb_downstream/work/magnus/samples/
runs/bc5_lhcb_downstream_v2/work/magnus/samples/
runs/20261016_144605_UTC_bc5_lhcb_downstream/work/magnus/hadron_lib/
runs/bc5_lhcb_downstream_v2/work/magnus/hadron_lib/
# GitHub rejects files > 100 MB; this one is attached to the release "samples-2026-10"
runs/20261025_1325_UTC_2HDM_lightH_lhcb_downstream/work/magnus/samples/minbias_pik.txt.gz
**/work/magnus/outputs/
**/work/magnus/**/*.tar.gz
**/work/magnus/**/*.zip
# compiled response-table caches (rebuilt automatically from the code + samples)
**/work/analysis/cache/
# per-mass scan JSONs (reproducible; the aggregated outputs/data/signal_scan.json is kept)
**/work/analysis/scan_2hdm/
**/work/analysis/scan_2hdm_*/
# run archives
runs/*.zip
# ---------------------------------------------------------------------------
# Vendored third-party sources (ColliderAgent, Magnus): fetch from upstream
# ---------------------------------------------------------------------------
deployment/sources/
# ---------------------------------------------------------------------------
# Python / build junk
# ---------------------------------------------------------------------------
**/__pycache__/
*.pyc
*.pyo
build/
*.obj
*.o
# ---------------------------------------------------------------------------
# Local scratch
# ---------------------------------------------------------------------------
temp/*
!temp/.gitkeep

# local deployment secrets (JWT signer key, internal endpoints) - never publish
configs/magnus_container.private.json
