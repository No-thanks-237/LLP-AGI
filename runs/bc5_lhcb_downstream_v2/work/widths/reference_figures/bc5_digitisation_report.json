  "topology": {
    "summary": "Each blue curve is ONE connected closed path, but it is the outline of a closed excluded BAND, not a single-valued function. Inside the axes each curve therefore appears as TWO separate branches - an upper edge and a lower edge - that are joined only by a short near-vertical segment at m_S = 62 GeV right at the right-hand end of the curve. The rest of the closure runs outside the plot frame (path vertices at x=-66.4 pt, y=-17.0 pt, clipped away) and is not visible, so nothing was recovered there.",
    "upper_lower_pair": true,
    "joint_locations": {
      "right": "x=406.914 pt (m_S=62.0 GeV): vertical segment linking the two edges (solid 119.6->190.0 pt, dashed 115.5->208.2 pt)",
      "left": "outside the axes at x=-66.4 pt, y=-17.0 pt (clipped, invisible)"
    },
    "branches_are_never_joined_in_the_csv": "the two edges are written as separate contiguous row blocks; no line joins them and no value is interpolated between them",
    "gaps_left_open": [
      "downstream_300fb upper edge: m_S = 1.087 -> 1.514 GeV lies above the top of the frame (theta2 > 1e-5) and is clipped; it is kept as a gap, not filled",
      "both edges are truncated at the left frame border (m_S = 0.201 GeV) because the drawn path leaves the axes there"
    ]
  },
